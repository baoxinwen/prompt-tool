{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Tool",
  "version": "1.2.0",
  "identifier": "com.prompt-tool.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNUY2QzFGRTUwNDBGRDEKUldUUkR3VGxIMnhmdnUrL1FvYUV5amZaZ0M0KzJydDlidmRFUTFxSGVPVy9oYSsrRmZRZC9lL2oK",
      "endpoints": [
        "https://github.com/baoxinwen/prompt-tool/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/baoxinwen/prompt-tool/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
